<!DOCTYPE html>
<html lang="en">

<head>
    <partial name="head" />
</head>

<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm py-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand text-info fw-bold fs-5" href="/Users/Index" style="letter-spacing: 0.5px;">
                <i class="bi bi-layers-half me-2"></i>Employee

            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-4">
                    <li class="nav-item me-2">
                        <a class="nav-link fw-medium px-3 navbar-custom-link" href="/Users/Index"
                           style="color: #4b5563 !important;">Users</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium px-3 navbar-custom-link" href="/Users/Create"
                           style="color: #4b5563 !important;">Create</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- Main Content -->
    <main class="flex-grow-1">
        <div class="container mt-4">
            <h1>@RenderSection(name: "mainHeading", required: false)</h1>
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white pb-0 pt-5 mt-5 mb-0">
        <div class="container text-center text-md-start">
            <div class="row text-center text-md-start">

                <!-- Section 1: Brand Info -->
                <div class="col-md-4 col-lg-4 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 font-weight-bold text-info">About Us</h5>
                    <p class="text-muted small">A streamlined system designed to manage your employee directory, track
                        professional records, and handle core workforce operations efficiently.</p>
                    </div>

                    <!-- Section 2: Quick Links -->
                    <div class="col-md-3 col-lg-3 mx-auto mt-3">
                        <h5 class="text-uppercase mb-4 font-weight-bold text-info">Explore</h5>
                        <p><a href="#" class="text-white text-decoration-none footer-link">Home</a></p>
                        <p><a href="#" class="text-white text-decoration-none footer-link">Our Services</a></p>
                        <p><a href="#" class="text-white text-decoration-none footer-link">Contact Us</a></p>
                    </div>

                    <!-- Section 3: Contact Info -->
                    <div class="col-md-4 col-lg-3 mx-auto mt-3">
                        <h5 class="text-uppercase mb-4 font-weight-bold text-info">Contact</h5>
                        <p class="text-muted"><i class="fas fa-envelope me-2 text-info"></i> info@example.com</p>
                        <p class="text-muted"><i class="fas fa-phone me-2 text-info"></i> +970 599 000 000</p>
                    </div>

                </div>

                <hr class="mb-4 bg-secondary">

                <!-- Bottom Section: Copyright & Socials -->
                <div class="row align-items-center">
                    <div class="col-md-7 col-lg-8 text-center text-md-start">
                        <p class="mb-0 text-muted">© 2026 All Rights Reserved by:
                            <a href="#" class="text-info text-decoration-none font-weight-bold">Tasneem</a>
                        </p>
                    </div>

                    <div class="col-md-5 col-lg-4 text-center text-md-end">
                        <ul class="list-unstyled list-inline mb-0">
                            <li class="list-inline-item">
                                <a href="#" class="text-white me-3" style="font-size: 20px;"><i
                                    class="fab fa-facebook"></i></a>
                                </li>
                                <li class="list-inline-item">
                                    <a href="#" class="text-white me-3" style="font-size: 20px;"><i
                                        class="fab fa-twitter"></i></a>
                                    </li>
                                    <li class="list-inline-item">
                                        <a href="#" class="text-white me-3" style="font-size: 20px;"><i
                                            class="fab fa-linkedin-in"></i></a>
                                        </li>
                                        <li class="list-inline-item">
                                            <a href="#" class="text-white" style="font-size: 20px;"><i class="fab fa-github"></i></a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </footer>
                    <partial name="Script" />

                    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)

                </body>

            </html>